# Environment for the maintenance scan. Copy to `.env` for local runs; the
# scheduled workflow sets GITHUB_TOKEN from `github.token` itself.
#
# Nothing here is required. Every variable only changes how much the scan can
# establish, never whether it runs — a scan that cannot reach an upstream
# reports the finding as unresolved rather than as up to date.

# Raises the GitHub API allowance from 60 requests an hour to 1,000, which is
# the difference between a complete scan and a mostly-unresolved one. Any token
# with public read scope will do. The variable NAME is configurable in
# maintenance.config.yaml under `sources.github.tokenEnv`; the token itself is
# never written there.
GITHUB_TOKEN=

# Only needed when `collectors.eks.latestStrategy` opts into the AWS CLI, which
# is off by default — the committed support calendar needs no credentials.
# See docs/maintenance/adr/0002-eks-support-calendar.md
AWS_REGION=
AWS_PROFILE=
